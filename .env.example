# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Paystack ──────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_live_...
PAYSTACK_PUBLIC_KEY=pk_live_...
# Use sk_test_ / pk_test_ for staging

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Use Upstash or Redis Cloud in production

# ── LiveKit ───────────────────────────────────────────────────────────────────
LIVEKIT_HOST=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
CLIENT_ORIGIN=https://grind.market,https://www.grind.market
NODE_ENV=production

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_USERNAME=grind_admin
ADMIN_PASSWORD=change_this_to_something_strong
ADMIN_JWT_SECRET=change_this_to_a_random_64_char_string

# ── Email (Nodemailer / Gmail app password) ───────────────────────────────────
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_app_password
ADMIN_EMAIL=goodnessiyamah1@gmail.com

# ── Blockchain (Base Sepolia for staging, Base Mainnet for production) ────────
RPC_URL=https://mainnet.base.org
PRIVATE_KEY=your_deployer_wallet_private_key
BASESCAN_API_KEY=your_basescan_api_key

# ── Frontend (Vite — must be prefixed VITE_) ──────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_API_URL=https://api.grind.market
VITE_PAYSTACK_PUBLIC_KEY=pk_live_...
VITE_GOOGLE_CLIENT_ID=24300395823-trbfqd7mjiho0tgl9jpaek4qtemuf5cd.apps.googleusercontent.com
