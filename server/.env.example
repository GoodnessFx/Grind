# Environment
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mitao?schema=public"

# JWT Secrets (generate random strings for production)
JWT_ACCESS_SECRET="mitao-dev-access-secret-change-in-production"
JWT_REFRESH_SECRET="mitao-dev-refresh-secret-change-in-production"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Admin JWT (separate from customer)
ADMIN_JWT_ACCESS_SECRET="mitao-admin-access-secret-change-in-production"
ADMIN_JWT_REFRESH_SECRET="mitao-admin-refresh-secret-change-in-production"
ADMIN_JWT_ACCESS_EXPIRY="10m"
ADMIN_JWT_REFRESH_EXPIRY="2h"

# Encryption key for API credentials at rest (32 bytes hex)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# CORS
FRONTEND_URL="http://localhost:8443"

# Currency API
EXCHANGE_RATE_API_URL="https://api.exchangerate.host/latest"
EXCHANGE_RATE_API_KEY=""

# Payment Providers (fill when ready)
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_HASH=""
FLUTTERWAVE_ENCRYPTION_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email (SendGrid or Resend)
SENDGRID_API_KEY=""
FROM_EMAIL="noreply@mitao.com"

# SMS (Termii)
TERMII_API_KEY=""
TERMII_SENDER_ID="Mitao"

# Push Notifications (Firebase)
FCM_SERVER_KEY=""

# Sentry
SENTRY_DSN=""

# DSFulfill
DSFULFILL_API_BASE_URL=""
DSFULFILL_API_KEY=""
DSFULFILL_API_SECRET=""

# CJ Dropshipping
CJ_API_KEY=""
CJ_ACCESS_TOKEN=""
CJ_REFRESH_TOKEN=""
